# Copy to .env.local and fill in. Server-only: never prefix with NEXT_PUBLIC_.
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your chat id, from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=
# Public address of the site, used in share links, sitemap and previews.
# Optional on Vercel (the production domain is used by default).
SITE_URL=
